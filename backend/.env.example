PORT=5000
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/story_blog
# Set to a random value of at least 32 characters before deployment.
JWT_SECRET=
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:4173
NODE_ENV=development
# Adds sample articles on the first start, only when the posts collection is empty.
SEED_ON_START=true
# Includes HTTP request summaries. Use info for lifecycle logs only.
LOG_LEVEL=http
# JSON files: backend/logs/combined.log and backend/logs/error.log.
LOG_TO_FILE=true
